# ─── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Pagos / SUNAT ─────────────────────────────────────
CULQI_PUBLIC_KEY=
CULQI_PRIVATE_KEY=
SUNAT_OSE_PROVIDER_URL=
SUNAT_OSE_USER=
SUNAT_OSE_PASSWORD=
SUNAT_RUC=

# ─── WhatsApp ──────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Push ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Sentry (observabilidad) ───────────────────────────
# DSN del proyecto Sentry de ESTA app (web y timeclock usan proyectos distintos).
# Si se deja vacío, Sentry queda inactivo (no envía nada).
NEXT_PUBLIC_SENTRY_DSN=
# Org y proyecto — usados solo en build para subir source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token para subir source maps. SOLO en Vercel/CI, nunca commitear.
SENTRY_AUTH_TOKEN=
# Token de LECTURA (scopes org:read, project:read, event:read) para que admin
# muestre métricas de Sentry en Agentes IA. Server-side, NO NEXT_PUBLIC.
SENTRY_API_TOKEN=

# ─── Email (Twilio Email API) ──────────────────────────────
# ⚠️ La Email API de Twilio es "Powered by Twilio SendGrid" y Twilio NO firma
# BAA para SendGrid. Hasta contratar un proveedor que lo cubra, el correo con
# PHI (el link del portal: nombre del paciente + código de caso) NO puede salir
# a pacientes reales. El allowlist de abajo es lo que lo impide.
#
# Sin esto en "true" no sale NINGÚN correo.
EMAIL_ENABLED=
# Remitente transaccional (no una dirección de marketing).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Destinos autorizados, separados por coma. Acepta direcciones exactas
# (juan@gmail.com) o dominios enteros (@precisionmedicalcare.com). Los dominios
# públicos (@gmail.com, @outlook.com…) se IGNORAN como comodín.
# Vacío = bloquea todo (falla cerrado a propósito).
# "*" = canal abierto — poner SOLO con el BAA firmado.
EMAIL_TEST_ALLOWLIST=
# Abre el carril SIN PHI (el aviso al abogado de que tiene un mensaje) a
# destinatarios reales, sin abrir el correo del portal. Seguro sin BAA: ese
# texto es fijo y no nombra pacientes.
EMAIL_AVISOS_SIN_PHI=

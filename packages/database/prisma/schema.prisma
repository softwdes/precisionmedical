// =====================================================
// LM Super Admin · Prisma Schema (Reference)
// Precision Medical
// =====================================================
//
// This is the canonical Prisma schema. Use this as the
// reference for your schema.prisma file.
//
// Models are grouped by domain. Phase 0 is the minimum
// to get authentication working. Subsequent phases add
// more models as documented in DATA_MODEL.md.
// =====================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// 1. IDENTITY
// =====================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?

  firstName String
  lastName  String
  avatarUrl String?
  phone     String?

  role   UserRole
  status UserStatus @default(ACTIVE)

  preferredLocale Locale @default(es)
  preferredTheme  Theme  @default(dark)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  employee Employee?
  lawyer   Lawyer?
  provider Provider?

  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastFailedAttemptAt DateTime?

  sessions      Session[]
  notifications Notification[]
  agentActions  AgentAction[]  @relation("ReviewedBy")
  auditLogs     AuditLog[]     @relation("ActorUser")
  activityBuckets UserActivityBucket[]

  // Phoenix 2026-06-05: relations a clinical catalogs (Templates + Diagnoses)
  createdTemplates   Template[]              @relation("TemplateCreatedBy")
  templateFavorites  TemplateFavorite[]      @relation("TemplateFavorites")
  diagnosisFavorites UserDiagnosisFavorite[] @relation("DiagnosisFavorites")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CONTADOR
  EMPLOYEE
  FRONT_DESK
  DOCTOR
  LAWYER
  PROVIDER
  AUDITOR_AI
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Locale {
  es
  en
}

enum Theme {
  light
  dark
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  device    String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =====================================================
// 2. WORKFORCE
// =====================================================

model Country {
  id       String   @id @default(cuid())
  code     String   @unique // "US", "BO", "PE"
  name     String
  currency Currency

  employees Employee[]
  wallets   Wallet[]

  @@map("countries")
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  employees Employee[]

  @@map("departments")
}

model Employee {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  employeeCode String  @unique
  externalId   String? // ID from external attendance DB

  firstName String
  lastName  String
  email     String
  phone     String?
  photoUrl  String?

  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  city      String?

  type      EmploymentType
  startDate DateTime
  endDate   DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  position     String

  supervisorId String?
  supervisor   Employee?  @relation("Supervision", fields: [supervisorId], references: [id])
  reports      Employee[] @relation("Supervision")

  baseSalary    Decimal?       @db.Decimal(12, 2)
  baseCurrency  Currency
  hourlyRate    Decimal?       @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  bankAccount   String? // encrypted at app level
  bankQrUrl     String?

  status EmployeeStatus @default(ACTIVE)

  payments        Payment[]
  tasks           Task[]             @relation("AssignedTo")
  reviewedTasks   Task[]             @relation("Supervisor")
  attendanceSync  AttendanceSync[]
  metricSnapshots MetricSnapshot[]
  documents       EmployeeDocument[]

  // Phoenix 2026-06-05: credentials clínicas (NPI/DEA/license) si position=DOCTOR.
  // Tabla separada para no inflar Employee con NULLs para empleados no-doctores.
  doctorCredentials DoctorCredentials?

  // Vínculo con el perfil clínico Provider (citas/labs/prescripciones).
  // Solo relevante cuando position=DOCTOR.
  providerProfile Provider?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([countryId])
  @@index([type])
  @@index([status])
  @@index([departmentId])
  @@index([externalId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  EXTERNAL
  CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  ZELLE
  WIRE
  OTHER
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type       DocumentType
  name       String
  fileUrl    String
  uploadedBy String

  createdAt DateTime @default(now())

  @@map("employee_documents")
}

enum DocumentType {
  CONTRACT
  ID
  NDA
  TAX_FORM
  OTHER
}

model AttendanceSync {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  date DateTime @db.Date

  clockIn    DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  clockOut   DateTime?

  totalHours Decimal? @db.Decimal(5, 2)
  isLate     Boolean  @default(false)
  isAbsent   Boolean  @default(false)

  externalId String?
  syncedAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_sync")
}

model Task {
  id String @id @default(cuid())

  title       String
  description String?

  assigneeId String
  assignee   Employee @relation("AssignedTo", fields: [assigneeId], references: [id])

  supervisorId String?
  supervisor   Employee? @relation("Supervisor", fields: [supervisorId], references: [id])

  status   TaskStatus   @default(ASSIGNED)
  priority TaskPriority @default(NORMAL)

  assignedDate  DateTime  @default(now())
  dueDate       DateTime
  completedDate DateTime?

  qualityRating   Int?
  qualityFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  REVIEWED
  REJECTED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model MetricSnapshot {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  date DateTime @db.Date

  punctualityScore  Decimal @db.Decimal(5, 2)
  taskOnTimeScore   Decimal @db.Decimal(5, 2)
  productivityScore Decimal @db.Decimal(5, 2)
  qualityScore      Decimal @db.Decimal(5, 2)
  attendanceScore   Decimal @db.Decimal(5, 2)

  globalScore Decimal @db.Decimal(5, 2)
  grade       Grade

  computedAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([globalScore])
  @@map("metric_snapshots")
}

enum Grade {
  A_PLUS
  A
  B
  C
  D
}

// =====================================================
// 3. FINANCE
// =====================================================

enum Currency {
  USD
  BOB
  PEN
}

model Wallet {
  id        String   @id @default(cuid())
  currency  Currency
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])

  name    String
  balance Decimal @default(0) @db.Decimal(15, 2)

  lastReconciledAt DateTime?
  lastReconciledBy String?
  lastMovementAt   DateTime?
  isActive         Boolean   @default(true)

  fxFromOps FxOperation[] @relation("FromWallet")
  fxToOps   FxOperation[] @relation("ToWallet")
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, countryId])
  @@map("wallets")
}

model FxOperation {
  id String @id @default(cuid())

  fromWalletId String
  fromWallet   Wallet @relation("FromWallet", fields: [fromWalletId], references: [id])

  toWalletId String
  toWallet   Wallet @relation("ToWallet", fields: [toWalletId], references: [id])

  amountFrom Decimal @db.Decimal(15, 2)
  amountTo   Decimal @db.Decimal(15, 2)
  rate       Decimal @db.Decimal(12, 6)
  fee        Decimal @default(0) @db.Decimal(10, 2)

  exchangeHouse String?
  receiptUrl    String?
  notes         String?

  performedById String
  performedAt   DateTime @default(now())

  reversedById String? // Append-only: edits create reversals

  createdAt DateTime @default(now())

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([performedAt])
  @@map("fx_operations")
}

model Payment {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  period String

  amountLocal    Decimal  @db.Decimal(12, 2)
  currencyLocal  Currency
  amountUsdEquiv Decimal  @db.Decimal(12, 2)
  rateApplied    Decimal  @db.Decimal(12, 6)

  status PaymentStatus @default(PENDING)

  scheduledDate DateTime
  paidDate      DateTime?

  proofUrl String?
  notes    String?

  baseSalary  Decimal? @map("base_salary") @db.Decimal(12, 2)
  bonusAmount Decimal? @map("bonus_amount") @db.Decimal(12, 2)
  bonusReason String?  @map("bonus_reason")

  reversedById String? // Append-only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([period])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SCHEDULED
  PAID
  PARTIAL
  CANCELLED
  REVERSED
}

model CashBox {
  id       String  @id @default(cuid())
  name     String  @unique
  clinicId String?

  currency            Currency @default(USD)
  balance             Decimal  @default(0) @db.Decimal(12, 2)
  lowBalanceThreshold Decimal  @default(100) @db.Decimal(12, 2)

  responsibleUserId String?
  qrDepositUrl      String? @map("qr_deposit_url")

  transactions CashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_boxes")
}

model CashTransaction {
  id        String  @id @default(cuid())
  cashBoxId String
  cashBox   CashBox @relation(fields: [cashBoxId], references: [id])

  type   CashTransactionType
  amount Decimal             @db.Decimal(12, 2)

  category    CashCategory
  description String

  receiptUrl String?

  performedById String
  performedAt   DateTime @default(now())

  reversedById String? // Append-only

  // Fase 4 — Caja Chica ↔ Wallet: si un DEPÓSITO se financió desde una
  // cartera, aquí guardamos cuál. Ese monto cuenta como salida de esa wallet
  // (en su misma moneda). Opcional: depósitos sin origen no afectan wallets.
  sourceWalletId String?

  createdAt DateTime @default(now())

  @@index([cashBoxId])
  @@index([performedAt])
  @@index([category])
  @@index([sourceWalletId])
  @@map("cash_transactions")
}

enum CashTransactionType {
  DEPOSIT
  EXPENSE
}

enum CashCategory {
  MEDICAL_SUPPLIES
  TRANSPORT
  FOOD
  OFFICE
  UTILITIES
  MAINTENANCE
  CALACOTO
  RECORDINGS
  VIATICOS
  OTHER
}

// =====================================================
// 4. EXTERNAL RELATIONS
// =====================================================

model Lawyer {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  entityType LawyerEntityType

  firstName String?
  lastName  String?
  firmName  String?

  parentFirmId String?
  parentFirm   Lawyer?  @relation("FirmMembers", fields: [parentFirmId], references: [id])
  members      Lawyer[] @relation("FirmMembers")

  email   String? @unique
  phone   String?
  address String?

  // Phoenix 2026-06-06 (B.30/B.31): campos extra para catálogo de Bufetes
  city          String? // Provo, West Valley, etc.
  state         String? // ISO state code (UT)
  zip           String? // ZIP code del member (puede diferir del bufete)
  barNumber     String? // Número de colegiado (solo ATTORNEY)
  recoveryRate  Float? // % de honorarios típico, ej. 33.3 = 33.3% (solo ATTORNEY)
  memberRole    LawyerMemberRole? // solo aplica si parentFirmId is set
  notes         String? // notas internas de Edson (privadas)
  paymentSpeed  PaymentSpeed? // marca rápido/lento para badge en B.30
  caseflowFlags String[]          @default([]) // PIP-COVERED, MED-PAY, etc.

  status ExternalStatus @default(ACTIVE)

  commissionConfig CommissionConfig?

  referrals   Patient[]    @relation("LawyerReferrer")
  commissions Commission[] @relation("LawyerCommission")

  // Phoenix 2026-06-06: relaciones a Case
  casesAsLawFirm     Case[] @relation("CaseLawFirm")
  casesAsAttorney    Case[] @relation("CaseAttorney")
  casesAsParalegal   Case[] @relation("CaseParalegal")
  casesAsLegalAssist Case[] @relation("CaseLegalAssistant")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([entityType])
  @@index([parentFirmId])
  @@index([city])
  @@map("lawyers")
}

// Phoenix 2026-06-06: rol del member dentro del bufete (B.31)
enum LawyerMemberRole {
  ATTORNEY // Abogado titular
  CASE_MANAGER // Manejador de casos · contacto operativo
  PARALEGAL // Asistente legal certificado
  LEGAL_ASSISTANT // Asistente legal
  OTHER
}

// Phoenix 2026-06-06: badge de velocidad de pago para listado B.30
enum PaymentSpeed {
  FAST // < 90 días promedio
  AVERAGE // 90-150 días
  SLOW // > 150 días (warn badge)
  UNKNOWN // sin data aún
}

enum LawyerEntityType {
  FIRM
  INDEPENDENT
  FIRM_MEMBER
}

model Provider {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Vínculo opcional con el registro HR del doctor en Employee
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  firstName String
  lastName  String

  email String  @unique
  phone String?

  specialty     Specialty
  licenseNumber String?
  npi           String?
  dea           String?

  // ScriptSure / DAW (D4 — prescripción electrónica)
  scriptsureUserId String?

  status ExternalStatus @default(ACTIVE)

  serviceTariffs ServiceTariff[]

  referrals    Patient[]     @relation("ProviderReferrer")
  commissions  Commission[]  @relation("ProviderCommission")
  appointments Appointment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("providers")
}

enum ExternalStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  TERMINATED
}

enum Specialty {
  RADIOLOGY
  NEUROLOGY
  ORTHOPEDICS
  PHYSICAL_THERAPY
  CHIROPRACTIC
  PAIN_MANAGEMENT
  PSYCHOLOGY
  GENERAL
  OTHER
}

model ServiceTariff {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  serviceName String
  amount      Decimal  @db.Decimal(10, 2)
  currency    Currency @default(USD)

  @@map("service_tariffs")
}

model Patient {
  id String @id @default(cuid())

  patientCode String @unique

  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?
  dateOfBirth DateTime?

  accidentDate     DateTime?
  accidentType     AccidentType?
  insuranceCarrier String?
  policyNumber     String?

  lawyerReferrerId String?
  lawyerReferrer   Lawyer? @relation("LawyerReferrer", fields: [lawyerReferrerId], references: [id])

  providerReferrerId String?
  providerReferrer   Provider? @relation("ProviderReferrer", fields: [providerReferrerId], references: [id])

  status PatientStatus @default(NEW)

  // ─── Demografía ──────────────────────────────────────────────────────────
  phone2                  String? // celular / segundo teléfono
  addressLine1            String?
  addressCity             String?
  addressState            String?
  addressZip              String?
  sex                     PatientSex?
  maritalStatus           MaritalStatus?
  employer                String?
  preferredPharmacy       String?
  communicationPreference CommunicationPreference?
  referralSource          ReferralSource?
  // Texto libre cuando referralSource = OTHER — el enum no puede llevarlo.
  referralSourceOther     String?
  race                    PatientRace?
  ethnicity               PatientEthnicity?
  socialSecurityNumber    String?

  // ─── Intake preferences (capturadas en B.6 portal) ───────────────────────
  preferredLanguage        String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // ─── Segundo contacto de emergencia ──────────────────────────────────────
  emergency2Name     String?
  emergency2Phone    String?
  emergency2Relation String?

  // ─── Responsable legal (requerido si es menor de edad) ───────────────────
  //
  // Vínculo real al apoderado, que SIEMPRE es otro Patient: si ya existía se
  // linkea, si no se crea uno nuevo (sin caso). Así sus datos de contacto,
  // fecha de nacimiento, etc. viven en su propia ficha y no duplicados acá —
  // y queda disponible para sus propias citas y casos futuros.
  //
  // `guardianName` / `guardianPhone` quedan por compatibilidad con la data
  // migrada del v2, que los tiene como texto suelto sin ficha asociada.
  guardianPatientId String?
  guardianPatient   Patient?  @relation("PatientGuardian", fields: [guardianPatientId], references: [id])
  dependents        Patient[] @relation("PatientGuardian")
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?

  // ─── EMR / Historial médico (JSON blob, Phase 1A) ───────────────────────
  medicalHistory Json?

  // ─── ScriptSure / DAW (D4 — prescripción electrónica) ────────────────────
  scriptsurePatientId  String?
  consentToDrugHistory Boolean?

  appointments Appointment[]
  commissions  Commission[]

  // Phoenix 2026-06-06: un paciente puede tener varios cases (varios MVAs)
  cases          Case[]            @relation("PatientCases")
  documents      PatientDocument[]
  callLogs       CallLog[]
  messageThreads MessageThread[]   @relation("PatientMessageThreads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lawyerReferrerId])
  @@index([providerReferrerId])
  @@index([status])
  @@map("patients")
}

enum PatientStatus {
  NEW
  ACTIVE
  COMPLETED
  DISCHARGED
  INACTIVE
}

enum PatientSex {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum PatientRace {
  AFRICAN_AMERICAN
  AMERICAN_INDIAN_ALASKA_NATIVE
  ASIAN
  NATIVE_HAWAIIAN
  PACIFIC_ISLANDER
  WHITE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PatientEthnicity {
  HISPANIC_LATINO
  NOT_HISPANIC_LATINO
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  OTHER
}

enum CommunicationPreference {
  PHONE
  EMAIL
  TEXT
  ANY
}

enum AccidentType {
  AUTO
  MOTORCYCLE
  PEDESTRIAN
  WORKPLACE
  OTHER
}

model Clinic {
  id        String  @id @default(cuid())
  name      String  @unique
  address   String?
  phone     String?
  cellPhone String?
  email     String?
  zipCode   String?
  state     String?
  city      String?
  color     String? @default("#6366F1")

  // ScriptSure / DAW (D4 — prescripción electrónica)
  scriptsurePracticeId String?

  appointments Appointment[]

  @@map("clinics")
}

// ScriptSure / DAW — cache del sessionToken (12h, por usuario que loguea).
// Serverless (Vercel) no puede guardarlo en memoria entre invocaciones.
model ScriptSureSession {
  id           String   @id @default(cuid())
  loginEmail   String   @unique
  sessionToken String
  practiceId   Int?
  prescriberId Int?
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("scriptsure_sessions")
}

/// Quién puede recibir una llamada entrante ahora mismo.
///
/// Twilio NO expone qué clientes tiene registrados, así que el ring group del
/// webhook de entrantes no tiene forma de preguntárselo: hay que llevar la
/// presencia por nuestra cuenta. Vive en la base y no en memoria por la misma
/// razón que `ScriptSureSession` — en serverless cada request puede caer en
/// una instancia distinta y no hay estado compartido en proceso.
///
/// El navegador manda un heartbeat mientras la app está abierta; el webhook
/// arma un `<Client>` por cada fila fresca. Una fila vieja significa que esa
/// persona cerró la pestaña o se quedó sin red, y marcarle el `<Client>` solo
/// haría esperar al paciente contra un cliente muerto.
model CallAgentPresence {
  /// userId de Supabase — el mismo que va a `CallLog.agentUserId`.
  userId String @id

  /// Identidad de Twilio (`user-<userId>`), denormalizada: el webhook arma el
  /// TwiML sin recalcular la convención.
  identity String

  /// Nombre para el `agentName` del CallLog cuando esta persona conteste.
  agentName String?

  lastSeenAt DateTime @updatedAt

  @@index([lastSeenAt])
  @@map("call_agent_presence")
}

/// Métricas por empleado y por doctor — tiempo de uso ACTIVO del sistema.
///
/// Una fila por usuario y por HORA (bucketStart truncado a la hora, UTC), con
/// un bitmap de los minutos en que hubo actividad. Lo alimenta el heartbeat de
/// `/api/activity/heartbeat` cada 20s mientras la pestaña está visible y hubo
/// interacción reciente. Máximo 24 filas/usuario/día.
/// "Tiempo activo del día" = SUM(activeMinutes) del rango.
model UserActivityBucket {
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Inicio de la hora (UTC). Denver va en horas enteras respecto de UTC, así
  /// que re-bucketear a días locales en la UI es exacto.
  bucketStart DateTime

  /// Bitmap de los 60 minutos de la hora con actividad (bit N = minuto N).
  /// El ping hace OR, así que marcar el mismo minuto dos veces no suma: es lo
  /// que vuelve el conteo inmune a pings repetidos, perdidos o de otra pestaña.
  minutesMask BigInt @default(0)

  /// Derivada del bitmap (popcount). Las filas anteriores al 2026-08-12
  /// conservan el conteo del modelo viejo, que subestimaba.
  activeMinutes Int      @default(0)
  lastPingAt    DateTime

  @@id([userId, bucketStart])
  @@index([bucketStart])
  @@map("user_activity")
}

model Appointment {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Phoenix 2026-06-06: link al Case del paciente
  caseId String?
  case   Case?   @relation("CaseAppointments", fields: [caseId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  scheduledFor    DateTime
  durationMinutes Int      @default(30)

  type   AppointmentType
  status AppointmentStatus @default(SCHEDULED)

  notes String?

  /// Cancelacion del MISMO DIA: el horario ya se perdio, asi que la visita
  /// conserva sus servicios y se le puede generar un cobro de penalidad — a
  /// diferencia de una cancelacion con aviso, que no cobra nada.
  ///
  /// Es un campo de INTENCION, no un calculo de fechas: recepcion elige el boton.
  /// Derivarlo de "se cancelo el mismo dia que la cita" quitaria la posibilidad
  /// de perdonar la penalidad cuando hubo una razon legitima.
  ///
  /// El CUANDO no va aca: la cancelacion ya queda con su fecha en el AuditLog.
  cancelledSameDay Boolean @default(false)

  // Telemedicine / online consultation toggle (FEATURE-006)
  isOnline   Boolean @default(false)
  meetingUrl String? // optional video link (Zoom, Teams, etc.)

  // B.15 Admisión — servicios planificados seleccionados por recepción antes de pasar al doctor
  // JSON snapshot: [{code, description, fee}]
  plannedServiceCodes Json @default("[]")

  // B.14 Check-in: timestamp cuando recepción confirma la llegada del paciente
  checkedInAt DateTime?

  /// B.15 — cuándo pasó a consulta con el doctor (IN_PROGRESS). Con
  /// doctorDoneAt/checkedOutAt define la DURACIÓN real de la consulta
  /// (métricas por doctor); checkedInAt incluye sala de espera y triaje.
  admittedAt DateTime?

  /// B.18 · El doctor terminó con el paciente (nodo Resumen del portal médico).
  /// NO cierra la cita: el asistente sigue viéndola en su cola y la pasa a
  /// COMPLETED cuando cobra. Son dos actos de dos personas distintas.
  doctorDoneAt DateTime?
  /// Hora en que el asistente cerró la visita (Checkout). Cierra el reloj de
  /// "tiempo en clínica": sin esto el contador corría desde el check-in hasta
  /// AHORA y las visitas sin cerrar mostraban 30 y 50 horas.
  checkedOutAt DateTime?

  // B.14.1 Firma de asistencia (paciente firma en tablet al llegar)
  attendanceSignedAt      DateTime?
  attendanceSignatureSvg  String?   @db.Text // PNG base64 del canvas
  attendanceSignatureHash String? // SHA-256(svg+appointmentId+timestamp)

  // B.16 Triaje — registro de signos vitales capturados por MA
  triageRecord TriageRecord?

  // B.18 Nota de visita — firmada por el doctor
  visitNote VisitNote?

  // Billing clínico (costs + payments migrados de v2)
  billing AppointmentBilling[]

  // B.20 Órdenes de laboratorio / imaging
  labOrders LabOrder[]

  // B.19 Prescripciones electrónicas
  prescriptions Prescription[]

  // Férulas / DME entregados en la visita
  braces AppointmentBrace[]

  // Servicios e inyectables cobrados en efectivo (catálogo cash)
  cashServices AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([caseId])
  @@index([clinicId])
  @@index([scheduledFor])
  @@index([status])
  @@index([providerId, scheduledFor])
  @@map("appointments")
}

enum AppointmentType {
  AUTO_ACCIDENT
  FAMILY_PRACTICE
  URGENT_CARE
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN // B.14: paciente llegó físicamente y hizo check-in en recepción
  IN_PROGRESS // B.15: pasó a sala con el doctor
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING
}

// ─── Triage Record (B.16 — Medical Assistant) ─────────────────────────────
//
// Signos vitales capturados por el MA antes de la visita del doctor.
// Uno por Appointment. Se auto-sincroniza al abrir la nota del doctor (B.18).
//
model TriageRecord {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // ─── Height ──────────────────────────────────────────────────────────────
  heightFt Int? // pies
  heightIn Int? // pulgadas
  heightCm Float? // cms auto-calculado (stored for audit)

  // ─── Weight ───────────────────────────────────────────────────────────────
  weightLbs Int?
  weightOz  Int?
  weightKg  Float? // kgs auto-calculado

  // ─── Blood Pressure (1st) ────────────────────────────────────────────────
  systolicMmhg  Int?
  diastolicMmhg Int?

  // ─── Pulse, Resp Rate & Temperature (1st) ────────────────────────────────
  pulseBpm        Int?
  respiratoryRate Int? // respiraciones/min
  tempFahrenheit  Float?
  tempCelsius     Float? // auto-calculado

  // ─── Pain ─────────────────────────────────────────────────────────────────
  painScale Int? // 0-10

  // ─── Oxygen ───────────────────────────────────────────────────────────────
  o2Saturation Int? // porcentaje (e.g., 98)
  o2Comment    String? // texto libre
  onRoomAir    Boolean @default(true)

  // ─── 2nd Reading ──────────────────────────────────────────────────────────
  systolicMmhg2    Int?
  diastolicMmhg2   Int?
  pulseBpm2        Int?
  respiratoryRate2 Int?
  tempFahrenheit2  Float?
  tempCelsius2     Float?

  // ─── Vision Acuity ────────────────────────────────────────────────────────
  visualAcuityRight String? // "20" (denominator de 20/X)
  visualAcuityLeft  String?
  visualAcuityBoth  String?
  visionCorrected   Boolean @default(false) // false=Uncorrected, true=Corrected

  // ─── Chief Complaint ──────────────────────────────────────────────────────
  chiefComplaint String? @db.Text

  // ─── Meta ─────────────────────────────────────────────────────────────────
  capturedByUserId String?
  capturedByName   String? @default("MA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("triage_records")
}

// ─── B.18 VisitNote ───────────────────────────────────────────────────────────

enum VisitNoteStatus {
  DRAFT // Auto-guardado, no firmado
  SIGNED // Firmado por doctor — inmutable
  VOIDED // Anulado (solo Super Admin)
}

/// Nota clínica SOAP generada por el doctor durante la visita.
/// Se crea como DRAFT al abrir B.18 y queda SIGNED al firmar.
model VisitNote {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  // Plantilla usada al inicio de la visita (snapshot reference)
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  // ─── Vitales (copia editable del triaje, separada de TriageRecord) ──────
  heightFt       Int?
  heightIn       Int?
  heightCm       Float?
  weightLbs      Int?
  weightOz       Int?
  weightKg       Float?
  systolicMmhg   Int?
  diastolicMmhg  Int?
  pulseBpm       Int?
  respRate       Int? // Frecuencia respiratoria
  tempFahrenheit Float?
  tempCelsius    Float?
  painScale      Int? // 0–10
  o2Saturation   Int?
  onRoomAir      Boolean?

  // ─── Secciones SOAP ─────────────────────────────────────────────────────
  chiefComplaint String? @db.Text // QUEJA_PRINCIPAL
  hpi            String? @db.Text // HPI
  ros            String? @db.Text // ROS
  physicalExam   String? @db.Text // EXAMEN_FISICO
  assessment     String? @db.Text // EVALUACIONES
  plan           String? @db.Text // PLAN

  // ─── Diagnósticos (1:N) ─────────────────────────────────────────────────
  diagnoses VisitNoteDiagnosis[]

  // ─── B.21 CPT services assigned to this visit ───────────────────────────
  serviceCodes VisitServiceCode[]

  // ─── B.20 Lab/imaging orders ────────────────────────────────────────────
  labOrders LabOrder[]

  // ─── B.19 Prescripciones electrónicas ───────────────────────────────────
  prescriptions Prescription[]

  // ─── Férulas / DME entregados ───────────────────────────────────────────
  braces AppointmentBrace[]

  // ─── Servicios e inyectables cobrados en efectivo ────────────────────────
  cashServices AppointmentService[]

  // ─── Estado y firma ─────────────────────────────────────────────────────
  status       VisitNoteStatus @default(DRAFT)
  signedAt     DateTime?
  signedById   String? // userId snapshot
  signedByName String? // nombre snapshot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([status])
  @@map("visit_notes")
}

// ─── B.21 VisitServiceCode ────────────────────────────────────────────────────
/// CPT / HCPCS codes asignados a una visita por el doctor antes de firmar.
/// fee_override permite ajustar el fee del catálogo por visita (self-pay, etc.).
/// Se crea junto con la nota DRAFT y queda locked al firmar.
/// Tablas en DB: migration 20260608020000_visit_service_codes.sql
/// NOTA: usar db.$queryRaw hasta regenerar Prisma client.
model VisitServiceCode {
  id            String       @id @default(cuid())
  visitNoteId   String
  visitNote     VisitNote    @relation(fields: [visitNoteId], references: [id], onDelete: Cascade)
  serviceCodeId String?
  serviceCode   ServiceCode? @relation(fields: [serviceCodeId], references: [id], onDelete: SetNull)

  // Snapshot al asignar
  cptCode        String
  description    String
  feeCatalog     Decimal  @db.Decimal(10, 2)
  feeOverride    Decimal? @db.Decimal(10, 2) // null = usar feeCatalog
  overrideReason String?

  modifier String?
  units    Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitNoteId, cptCode])
  @@index([visitNoteId])
  @@map("visit_service_codes")
}

// ─── B.20 Lab/Imaging Order ───────────────────────────────────────────────────
/// Orden de laboratorio, imaging o cardiología creada por el doctor
/// desde la nota SOAP. Aparece como "acción requerida" al resultar.
/// Tablas en DB: migration 20260608030000_lab_orders.sql
/// NOTA: usar db.$queryRaw hasta regenerar Prisma client.

enum LabOrderType {
  LABORATORY
  IMAGING
  CARDIOLOGY
  OTHER
}

enum LabOrderUrgency {
  STAT
  URGENT
  ROUTINE
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  RESULTED
  VOIDED
}

/// Quién paga el estudio (los labels del v2: Cliente, Paciente, Privado,
/// Medicaid, Medicare, Compensación laboral). Se guarda el enum, no el texto.
enum LabBillingType {
  CLIENT
  PATIENT
  PRIVATE
  MEDICAID
  MEDICARE
  WORKERS_COMP
}

/// Dónde se toma la muestra: en la clínica (queda en cola para el MA) o
/// el paciente va al laboratorio / centro de imagen con la orden impresa.
enum LabCollectionSite {
  IN_HOUSE
  EXTERNAL
}

model LabOrder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  visitNoteId   String?
  visitNote     VisitNote?  @relation(fields: [visitNoteId], references: [id], onDelete: SetNull)

  /// Agrupa los estudios pedidos en la MISMA orden — se imprimen en una sola
  /// hoja, pero cada estudio sigue su propio estado y resultado.
  groupId String?

  orderType          LabOrderType
  studyName          String
  studyCode          String? // código del catálogo (LabCorp / interno)
  loincCode          String?
  clinicalIndication String            @db.Text
  urgency            LabOrderUrgency   @default(ROUTINE)
  billingType        LabBillingType?
  collectionSite     LabCollectionSite @default(EXTERNAL)
  /// Fecha de toma de muestra (labs) o de la cita del estudio (imagen)
  sampleDate         DateTime?
  preferredCenter    String?
  icd10Codes         String[]          @default([])

  status        LabOrderStatus @default(ORDERED)
  orderedAt     DateTime       @default(now())
  orderedByName String?

  // ─── Resultado (PDF que sube el asistente cuando llega del laboratorio) ──
  resultFileUrl        String?
  resultFileName       String?
  resultUploadedAt     DateTime?
  resultUploadedByName String?
  resultNotes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([visitNoteId])
  @@index([groupId])
  @@map("lab_orders")
}

// ─── B.19 Prescriptions ────────────────────────────────────────────────────────

enum RxStatus {
  DRAFT
  SENT
  PENDING_DAW
  VOIDED
  /// ScriptSure reportó `messageStatus: "Error"` — la receta NO llegó a la
  /// farmacia. Distinto de VOIDED (que es una anulación deliberada): acá el
  /// doctor tiene que reintentar. Mostrarlo como "enviada" sería peligroso.
  ERROR
}

/// Prescripción electrónica DAW/EPCS.
/// Phase 1A: almacena localmente. Phase 2: integración real DAW.
model Prescription {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  visitNoteId   String?
  visitNote     VisitNote?  @relation(fields: [visitNoteId], references: [id], onDelete: SetNull)

  // Drug snapshot
  drugName    String
  drugGeneric String?
  deaSchedule String? // 'II' | 'III' | 'IV' | 'V' | null (non-controlled)

  // Rx details
  dose               String
  frequency          String
  durationStr        String
  quantityTotal      Int
  refills            Int    @default(0)
  clinicalIndication String @db.Text

  // Pharmacy
  pharmacyName    String?
  pharmacyAddress String?

  // Prescriber snapshot
  prescriberName String?
  prescriberDea  String?

  // Status
  status RxStatus @default(DRAFT)

  // DAW integration (Phase 2)
  dawRxId   String?
  dawSentAt DateTime?

  /// Identificadores del medicamento que devuelve ScriptSure. Se guardan para
  /// poder REPETIR la receta: su carrito (MedCart) identifica el fármaco por
  /// `routedMedId` + `gcnSeqno`, no por nombre. Sin esto, repetir obligaría al
  /// doctor a buscar el medicamento de nuevo a mano.
  ndc              String?
  rxNorm           String?
  /// Tipo de código RxNorm ("SCD" genérico, "SBD" de marca…). El mensaje NCPDP
  /// hacia la farmacia lo exige de un conjunto cerrado; sin él, ScriptSure
  /// rechaza el envío ("The value '' is not an element of the set {…}").
  rxNormQualifier  String?
  routedMedId      String?
  gcnSeqno         String?
  scriptsureDrugId String?
  /// Código NCPDP de la farmacia (ej. "0000420"). ScriptSure la resuelve por
  /// este id, no por el nombre — sin él, al repetir la receta queda sin destino.
  pharmacyId       String?
  /// Unidad de la cantidad (tableta, mL…). Su carrito la exige junto al número.
  quantityQualifier String?
  /// El objeto del fármaco TAL COMO lo devuelve ScriptSure, guardado entero.
  /// Su mensaje a la farmacia exige metadatos que no tienen columna propia
  /// (MED_NAME_TYPE_CD, MED_REF_*, la indicación estructurada). Reconstruirlos
  /// campo por campo llevó a un ciclo de rechazos; reenviar el original no.
  drugPayload      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([visitNoteId])
  @@index([status])
  @@map("prescriptions")
}

/// Lado del cuerpo — una rodillera izquierda no es la misma que la derecha.
enum BraceSide {
  NA // el item no distingue lado (ej. faja lumbar)
  LEFT
  RIGHT

  @@map("brace_side")
}

enum BraceStatus {
  DISPENSED
  RETURNED // el paciente la devolvió (talla equivocada)
  VOIDED // se cargó por error

  @@map("brace_status")
}

/// Férula / DME entregado al paciente en una visita.
///
/// Tabla propia (no una línea del JSON `plannedServiceCodes`) porque cada entrega
/// es un hecho clínico y contable con su lado, talla y cantidad.
///
/// Los campos de catálogo son SNAPSHOT deliberado: si mañana cambia el precio o
/// el HCPCS del item, esta visita tiene que seguir mostrando lo que realmente se
/// entregó y cobró. Mismo criterio que labs y servicios.
///
/// Se cobra SIEMPRE completa, sin lien ni seguro (`CatalogItem.alwaysFullPayment`).
/// No hay control de stock: si más adelante hace falta, se calcula sumando estas
/// filas — por eso cada entrega es un registro, aunque se repita el mismo item.
model AppointmentBrace {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  visitNoteId   String?
  visitNote     VisitNote?  @relation(fields: [visitNoteId], references: [id], onDelete: SetNull)

  /// Item del catálogo (catalog_items.id). Sin FK: el catálogo es soft-delete y
  /// la entrega no debe desaparecer si el item se retira.
  catalogItemId Int?

  // Snapshot del catálogo al momento de entregar
  code       String
  name       String
  sizeLabel  String?
  hcpcsCode  String?
  unitPrice  Decimal @db.Decimal(10, 2)

  side     BraceSide @default(NA)
  quantity Int       @default(1)

  status     BraceStatus @default(DISPENSED)
  voidedAt   DateTime?
  voidReason String?
  notes      String?

  /// Quién la entregó — puede ser el doctor o el asistente
  dispensedByName String?
  dispensedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([visitNoteId])
  @@index([status])
  @@map("appointment_braces")
}

/// Servicio o inyectable del catálogo CASH cobrado en una visita.
///
/// Los cargos de una visita salen de dos catálogos distintos y no se pueden
/// mezclar en una tabla:
///  · `service_codes` → `VisitServiceCode` — se factura a la aseguradora (CPT).
///  · `catalog_items` (INJECTION/SERVICE) → esta tabla — lo paga el paciente.
///
/// Mismo criterio que `AppointmentBrace`: el cargo se identifica por REGISTRO y
/// no por código, así dos aplicaciones del mismo inyectable son dos cobros y no
/// uno colapsado (el bug que sigue vivo en `sync-billing` con los CPT).
model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  visitNoteId   String?
  visitNote     VisitNote?  @relation(fields: [visitNoteId], references: [id], onDelete: SetNull)

  /// `catalog_items.id`. Sin FK: el catálogo es soft-delete y el cargo no debe
  /// desaparecer si el ítem se retira.
  catalogItemId Int?

  // Snapshot del catálogo al momento de cobrar
  code      String
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  /// Código de seguro del ítem, si lo tiene cargado. Se guarda como evidencia
  /// de que se cobró en efectivo algo que era facturable — no se usa para
  /// facturar, justamente porque el paciente ya lo pagó.
  cptCode   String?
  unitLabel String?

  quantity Int @default(1)

  status     CashServiceStatus @default(CHARGED)
  voidedAt   DateTime?
  voidReason String?
  notes      String?

  /// Quién lo cargó — puede ser el doctor o el asistente
  chargedByName String?
  chargedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([visitNoteId])
  @@index([status])
  @@map("appointment_services")
}

enum CashServiceStatus {
  CHARGED
  VOIDED

  @@map("cash_service_status")
}

/// Diagnóstico asociado a una nota de visita (ICD-10 + SNOMED dual).
model VisitNoteDiagnosis {
  id     String    @id @default(cuid())
  noteId String
  note   VisitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  icd10Code   String?
  icd10Label  String?
  snomedCode  String?
  snomedLabel String?

  // Referencia al catálogo si viene de una búsqueda
  diagnosisId String?
  diagnosis   Diagnosis? @relation(fields: [diagnosisId], references: [id])

  sortOrder Int @default(0)

  @@index([noteId])
  @@map("visit_note_diagnoses")
}

// =====================================================
// 5. COMMISSIONS

// =====================================================
// 6B. FREELANCERS
// =====================================================

enum FreelancerModalidad {
  POR_HORA
  POR_SERVICIO
  CONTRATISTA
}

enum FreelancerStatus {
  ACTIVE
  INACTIVE
}

enum FreelancerPaymentStatus {
  PENDING
  PAID
  CANCELLED
  REVERSED
}

model Freelancer {
  id         String              @id @default(cuid())
  nombre     String
  email      String?
  phone      String?
  pais       String
  modalidad  FreelancerModalidad
  tarifaBase Decimal?            @db.Decimal(10, 2)
  moneda     Currency            @default(USD)
  status     FreelancerStatus    @default(ACTIVE)
  notas      String?
  bankQrUrl  String?

  payments FreelancerPayment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([modalidad])
  @@map("freelancers")
}

model FreelancerPayment {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  descripcion String
  modalidad   FreelancerModalidad
  horas       Decimal?            @db.Decimal(8, 2)
  tarifaHora  Decimal?            @db.Decimal(10, 2)
  monto       Decimal             @db.Decimal(12, 2)
  moneda      Currency            @default(USD)

  status        FreelancerPaymentStatus @default(PENDING)
  fechaServicio DateTime                @db.Date
  scheduledDate DateTime?               @db.Date
  fechaPago     DateTime?               @db.Date
  paidDate      DateTime?               @db.Date

  bonusAmount Decimal? @db.Decimal(12, 2)
  bonusReason String?

  reversedById String? // Append-only — points to the reversal pair

  notas String?

  createdAt DateTime @default(now())

  @@index([freelancerId])
  @@index([fechaPago])
  @@index([status])
  @@index([status, scheduledDate])
  @@map("freelancer_payments")
}

// =====================================================
// 7. SYSTEM
// =====================================================

model AuditLog {
  id String @id @default(cuid())

  // Phoenix 2026-06-05: actorType hook obligatorio para AI Receptionist Phase 3+.
  // Hoy todos los registros son HUMAN_USER; el schema lo soporta para que en
  // Phase 3 podamos auditar acciones del AI agent sin migration breaking.
  actorType ActorType @default(HUMAN_USER)

  actorUserId String?
  actor       User?     @relation("ActorUser", fields: [actorUserId], references: [id])
  actorRole   UserRole?

  // Phoenix 2026-06-05: idempotency-key opcional para reintentos del AI agent.
  // AI puede reintentar la misma llamada si pierde conexión; este key previene duplicados.
  idempotencyKey String?

  action     String
  entityType String?
  entityId   String?

  ipAddress String?
  userAgent String?

  before   Json?
  after    Json?
  metadata Json?

  createdAt DateTime @default(now())

  // Métricas por empleado: groupBy(actorUserId, action) en un rango de fechas.
  // El compuesto cubre también las búsquedas por actorUserId solo (prefijo).
  @@index([actorUserId, action, createdAt])
  @@index([actorType])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("audit_logs")
}

// Phoenix 2026-06-05: tipo de actor para audit log.
// HUMAN_USER = acción iniciada por usuario humano via UI.
// AI_AGENT   = acción iniciada por AI Receptionist (Phase 3+) u otros agentes AI.
// SYSTEM     = acción iniciada por cron/webhooks/scheduled tasks.
enum ActorType {
  HUMAN_USER
  AI_AGENT
  SYSTEM
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  linkUrl String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  TASK_ASSIGNED
  PAYMENT_PROCESSED
  COMMISSION_EARNED
  PATIENT_REFERRED
  AGENT_ALERT
  PERFORMANCE_REPORT
}

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// =====================================================
// PHOENIX (LM v3) — Phase 0 additions · NO-PHI catalogs
// Added 2026-06-05 · Erick + Claude
// =====================================================
// These models support the clinical workflow (B.17.5-B.18, B.35)
// captured from the LM legacy. They are catalog/metadata only —
// patient data (PHI) does NOT live here. Phase 1 adds PHI tables
// (patients, cases, visits, notes) AFTER BAA Supabase signs.
// =====================================================

// ─── Doctor Credentials (clinical extension of Employee) ─────────
//
// One-to-one with Employee where Employee.position = 'DOCTOR'.
// Separate table to avoid inflating Employee with NULLable
// clinical fields for the 90% of employees who are not doctors.
// All fields are clinical credentials — NOT PHI (provider data).
model DoctorCredentials {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // National Provider Identifier — mandatory for HCFA (CMS-1500) claim submission.
  // Source: NPPES (https://npiregistry.cms.hhs.gov). Public registry.
  npiNumber String? @unique

  // DEA (Drug Enforcement Administration) number — required to prescribe
  // controlled substances via DAW EPCS (B.19). Restricted access.
  deaNumber String? @unique

  // State medical license — required to practice. State must match
  // clinic state for non-telehealth visits.
  medicalLicenseNumber String?
  medicalLicenseState  String? // ISO state code (e.g. "UT")

  specialty    Specialty // Legacy enum — backward compat. Primary specialty también va en DoctorSpecialtyAssignment.
  signatureUrl String? // Digital signature for SOAP notes (B.21 firma)

  isActive Boolean @default(true)

  // Phoenix 2026-06-06: many-to-many con SpecialtyCatalog (B.36)
  specialtyAssignments DoctorSpecialtyAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([npiNumber])
  @@index([deaNumber])
  @@index([specialty])
  @@map("doctor_credentials")
}

// ─── Templates (B.17.5 / B.17.6 / B.17.7) ────────────────────────
//
// Doctor note templates captured from the LM legacy. Each template
// has sections (CC/HPI/ROS/PE/Eval/Plan/Dx) which are toggleable
// per use. Sections can contain variants (tiered options), procedural
// blocks (e.g. trigger point injection), and price references (snapshot
// at signing for closing case notes → demand letter B.28).

enum TemplateScope {
  PERSONAL // Owned by single doctor (default for new templates)
  SHARED // Available to all doctors across all clinics
  SPECIALTY // Available only to doctors of a specific specialty
}

enum EncounterType {
  FOLLOW_UP
  NEW_PATIENT
  RE_EVAL
  URI // Upper Respiratory Infection
  PHYSICAL // Annual physical
  NURSING_HOME
  CLOSING // MMI / discharge case (with future-care prices)
  OTHER
}

enum CaseType {
  MVA // Motor Vehicle Accident — primary at Precision Medical
  GENERAL
  NURSING_HOME
}

enum TemplateSectionKey {
  QUEJA_PRINCIPAL // Chief Complaint
  HPI // Historia de la Enfermedad Actual (History of Present Illness)
  ROS // Revisión de Sistemas (Review of Systems)
  EXAMEN_FISICO // Physical Exam
  EVALUACIONES // Assessment (tiered + causation statement for PI)
  PLAN // Treatment plan (with variants + procedural + prices)
  DIAGNOSTICOS // Diagnoses (ICD-10 + SNOMED dual)
}

model Template {
  id String @id @default(cuid())

  title       String // e.g. "NG-MVA F/U" (prefix=doctor, suffix=encounter type)
  description String? // e.g. "Motor Vehicle Accident Follow-up"

  encounterType EncounterType
  caseType      CaseType      @default(GENERAL)
  scope         TemplateScope @default(PERSONAL)

  // For SPECIALTY scope: which specialty owns this template.
  // Null for PERSONAL/SHARED.
  // NOTE: Specialty enum exists in this schema (Provider model uses it).
  specialty Specialty?

  createdById String
  createdBy   User   @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  sections   TemplateSection[]
  favorites  TemplateFavorite[]
  visitNotes VisitNote[]

  usageCount Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([scope])
  @@index([encounterType])
  @@index([caseType])
  @@index([createdById])
  @@index([specialty])
  @@map("templates")
}

model TemplateSection {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  sectionKey       TemplateSectionKey
  content          String             @db.Text // HTML rich text with placeholders
  enabledByDefault Boolean            @default(true)

  // Tiered options inline (e.g. Evaluaciones Básica/Intermedia/Severa).
  // Doctor deletes variants that don't apply. JSON shape:
  // [{ label: string, content: string }]
  variants Json?

  // Reusable procedural notes (e.g. trigger point injection narrative).
  // Conditionally activated by doctor. JSON shape:
  // [{ trigger: string, content: string, cpt_code: string, consent_required: boolean }]
  proceduralBlocks Json?

  // Price references for Closing Case notes. Snapshot taken at signing
  // (B.18 firma) — feeds demand letter (B.28). JSON shape:
  // [{ label: string, cpt_code: string }]
  priceReferences Json?

  // Locked content blocks that require confirm to delete (e.g. PI causation
  // statement: "reasonable degree of medical certainty..."). JSON shape:
  // [{ content_substring: string, warning_message: string }]
  lockedBlocks Json?

  orderIndex Int @default(0)

  @@unique([templateId, sectionKey])
  @@index([templateId])
  @@map("template_sections")
}

model TemplateFavorite {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("TemplateFavorites", fields: [userId], references: [id])

  // Personal usage tracking for autocomplete ranking
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([templateId, userId])
  @@index([userId])
  @@index([userId, usageCount])
  @@map("template_favorites")
}

// ─── Diagnoses (B.35) — Dual ICD-10 + SNOMED CT ──────────────────
//
// Both code systems are FREE for clinical use in the US:
// - ICD-10-CM: published by CDC annually. ~70K codes.
//   https://www.cdc.gov/nchs/icd/icd-10-cm/files.html
// - SNOMED CT: licensed but FREE for US clinical use via NLM/UMLS.
//   ~350K concepts.
//   https://www.nlm.nih.gov/healthit/snomedct/index.html
//
// Pattern from legacy: each diagnosis row pairs an ICD-10 (for billing
// HCFA/CMS-1500) with an optional SNOMED (for clinical granularity +
// longitudinal reports). DiagnosisMapping table allows additional
// 1-to-many alternates if needed beyond the primary pair.

enum DiagnosisCategory {
  S // Lesiones (Injuries) — S00-T98 in ICD-10
  T // (continuation of S range)
  M // Musculoesqueléticas / Musculoskeletal — M00-M99
  R // Síntomas / Symptoms — R00-R99
  G // Neurológicas / Neurological — G00-G99
  F // Mental / Behavioral — F00-F99
  V_W // External cause (accident) — V00-W99 (e.g. V43.52XA MVA codes)
  Z // Factors influencing health — Z00-Z99
  OTHER
}

model Diagnosis {
  id String @id @default(cuid())

  // Dual coding — primary pair
  icd10Code         String  @unique
  icd10Description  String
  snomedCode        String?
  snomedDescription String?

  category   DiagnosisCategory
  bodySystem String? // e.g. "Cervical spine", "Lumbar spine", "Head"
  piRelevant Boolean           @default(false) // Flag for PI workflow

  // Usage tracking for autocomplete ranking
  usageCount Int     @default(0)
  isActive   Boolean @default(true)

  favorites          UserDiagnosisFavorite[]
  mappings           DiagnosisMapping[]
  visitNoteDiagnoses VisitNoteDiagnosis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([icd10Code])
  @@index([snomedCode])
  @@index([category])
  @@index([piRelevant])
  @@map("diagnoses")
}

// Cross-reference for additional ICD-10 ↔ SNOMED mappings beyond the
// primary pair on Diagnosis. Useful when one ICD-10 has multiple valid
// SNOMED concepts of varying specificity.
model DiagnosisMapping {
  id          String    @id @default(cuid())
  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  alternateIcd10  String?
  alternateSnomed String?

  // EXACT (1:1), BROADER (alternate is more general),
  // NARROWER (alternate is more specific), RELATED (lateral concept)
  mappingType String

  notes String? @db.Text

  @@index([diagnosisId])
  @@map("diagnosis_mappings")
}

model UserDiagnosisFavorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("DiagnosisFavorites", fields: [userId], references: [id])
  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  // Personal usage tracking for autocomplete ranking
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, diagnosisId])
  @@index([userId])
  @@index([userId, usageCount])
  @@map("user_diagnosis_favorites")
}

// ─── Specialty Catalog (B.36) ─────────────────────────────────────
//
// Source-of-truth de las líneas de servicio de la clínica.
// Reemplaza al enum legacy `Specialty` (que sigue existiendo arriba
// para compatibilidad con Provider/DoctorCredentials/Template, pero
// el CRUD opera sobre esta tabla).
//
// Mockup canónico: B.36 (Catálogo de Especialidades / Service lines).
// Mejoras vs LM legacy: color picker · CPT codes sugeridos · métricas
// agregadas · soft delete · cardinalidad muchos-a-muchos con doctores.

model SpecialtyCatalog {
  id String @id @default(cuid())

  name        String   @unique // "Auto Accidents", "Pain Management", etc.
  description String?
  color       String // hex "#F43F5E" — consumido en B.10 calendar, B.17 Mi día, B.29 dashboard
  caseType    CaseType @default(GENERAL)

  // CPT codes sugeridos — pre-cargan en B.21 al firmar nota
  cptSuggested String[] @default([])

  // Workflow type asociado:
  // - 'MVA' → flujo PI con lien
  // - 'GM'  → general medicine, no lien
  // - 'SELFPAY' → membership / direct pay
  workflowType String @default("MVA") // MVA | GM | SELFPAY | NURSING_HOME

  isActive Boolean @default(true)

  // Order for UI display
  sortOrder Int @default(0)

  // Many-to-many: doctors assigned to this specialty
  doctorAssignments DoctorSpecialtyAssignment[]

  // Phoenix 2026-06-06: cases con esta specialty
  cases Case[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([workflowType])
  @@map("specialty_catalog")
}

// ─── Service Codes Catalog (B.33) — CPT / HCPCS / Custom ─────────
//
// Master data de todos los códigos facturables. Consumido en B.21 (CPT
// + Firma del doctor) y B.26 (HCFA generation por Brunella).
// Versionado por año fiscal — fee_schedule cambia cada Enero.

enum ServiceType {
  CPT // Códigos AMA · cambian anualmente
  HCPCS // CMS Level II · drugs/DME · gratis
  CUSTOM_PM // Internos con prefijo PM-* · no van a aseguradora
}

enum ServiceCategory {
  EM // Evaluation & Management (99213, 99214, etc.)
  CHIROPRACTIC // 98941, 98942
  PHYSICAL_THERAPY // 97110, 97140
  IMAGING // 70010-79999
  INJECTIONS // 20552, 64483, 64633
  SURGERY // 10000-69999
  DME // Durable Medical Equipment
  DRUGS // J-codes
  LAB // Laboratorio
  REPORTS // Narrativas legales, depo prep
  CUSTOM // PM- internos
  OTHER
}

model ServiceCode {
  id String @id @default(cuid())

  code             String // "98941", "J3301", "PM-DIRECT"
  type             ServiceType
  shortDescription String // Display name corto
  longDescription  String?     @db.Text // Full AMA description

  category ServiceCategory

  // Fee schedule actual (Phase 1A: un solo fee per code · Phase 2: tabla historical)
  currentFee Decimal @db.Decimal(10, 2)
  fiscalYear Int     @default(2026)

  // Modificadores CPT permitidos (e.g. "-25", "-59")
  modifiersAllowed String[] @default([])

  // Notas de bundling (códigos que NO pueden facturarse juntos)
  bundlingNotes String? @db.Text

  // Metadata
  isActive       Boolean @default(true)
  isInternalOnly Boolean @default(false) // True para CUSTOM_PM
  sortOrder      Int     @default(0)
  notes          String? @db.Text

  // Sugerido por especialidades (links a SpecialtyCatalog vía SpecialtyCatalog.cptSuggested array)
  // No FK directo porque ya se almacena en SpecialtyCatalog.cptSuggested[] como strings.

  favorites        UserServiceFavorite[]
  visitAssignments VisitServiceCode[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([code, fiscalYear])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@map("service_codes")
}

/// Favorito de un ítem cobrable, de CUALQUIERA de los dos catálogos.
///
/// Una tabla con dos tipos y no dos tablas: el picker ordena "favoritos primero"
/// en UNA consulta, y `usageCount`/`lastUsedAt` es la misma métrica para las dos
/// fuentes — duplicar la tabla duplicaría esa lógica.
///
/// Un CHECK en la DB (`user_service_favorites_one_target`) garantiza que cada
/// fila apunte a uno y solo uno: con los dos, o con ninguno, no significa nada.
model UserServiceFavorite {
  id            String       @id @default(cuid())
  userId        String // Sin FK a User Phase 1A (no auth todavía) · Phase 1B FK real
  serviceCodeId String?
  serviceCode   ServiceCode? @relation(fields: [serviceCodeId], references: [id], onDelete: Cascade)
  /// `catalog_items.id` — sin FK: el catálogo es soft-delete y el favorito no
  /// debe hacer fallar un borrado lógico.
  catalogItemId Int?

  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, serviceCodeId])
  @@unique([userId, catalogItemId])
  @@index([userId])
  @@index([userId, usageCount])
  @@index([catalogItemId])
  @@map("user_service_favorites")
}

// ─── Phoenix Cases (B.1-B.4 Front Office + flujo completo) ──────────
//
// El Case es el contenedor principal del workflow PI. Orquesta:
// - 1 Patient (datos personales · puede tener múltiples Cases si hay
//   varios accidentes en distintos momentos)
// - 1 Bufete (FIRM) + 1 Attorney específico (INDEPENDENT del firm)
// - 1 Insurance primaria (PIP usualmente) + opcional secundaria (Med Pay)
// - 1 Specialty (Auto Accidents típico)
// - N Appointments
// - N CaseNotes (notas internas)
//
// Status flow: NEW_REFERRAL → INTAKE_PENDING → INTAKE_COMPLETED →
// CONFIRMED → ACTIVE → MMI → CLOSED → SETTLED → ARCHIVED.

enum CaseStatus {
  NEW_REFERRAL // Recién creado · cita aún no confirmada
  INTAKE_PENDING // Magic link enviado · esperando paciente complete B.5-B.9
  INTAKE_COMPLETED // Paciente completó portal
  CONFIRMED // Primera cita confirmada (llamada 24h antes)
  ACTIVE // Tratamiento en curso
  MMI // Maximum Medical Improvement
  CLOSED // Caso cerrado · pendiente settlement
  SETTLED // Settlement recibido por Brunella
  ARCHIVED // Histórico
  CANCELLED // No prosperó · no-show inicial · otros
}

enum ReferralSource {
  // Legacy — mantener para datos existentes
  PHONE_CALL // Recepción humana en B.1
  WALK_IN // Paciente camina sin cita
  WEB_FORM // Form público
  AI_AGENT // Phase 3+ Vapi/Retell
  // Activos en UI
  LAW_FIRM // Abogado / Bufete de abogados
  LAW_FIRM_REFERRAL // alias legacy → mismo concepto
  WEB_SEARCH // Búsqueda web
  ACCIDENT_CENTER // Centro de accidentes (ej. Axcess)
  FACEBOOK
  FAMILY // Familiar
  GOOGLE
  GOOGLE_MAPS
  INSTAGRAM
  WEBSITE // Página web
  CLINIC_STAFF // Personal de la clínica
  CHIROPRACTOR // Quiropráctico
  REFERRAL // Recomendación general
  PATIENT_REFERRAL // Recomendación de paciente existente
  INSURANCE // Seguro
  MEDICAL_INSURANCE // Seguro médico
  TIKTOK
  OTHER
}

enum CaseTypeWorkflow {
  MVA // Motor Vehicle Accident — PI con lien
  GENERAL // Medicina general (no lien)
  WORKERS_COMP // Workers' compensation
  NURSING_HOME // Visitas domiciliarias
}

/// Quién paga la visita. Lo consume el staff clínico para saber qué precio
/// cotizar; NO filtra catálogos (las dos listas se muestran siempre).
enum CoverageType {
  UNKNOWN // Nadie lo respondió todavía
  INSURANCE // Tiene seguro médico
  SELF_PAY // No tiene / prefiere pagar de su bolsillo
  LIEN // MVA con lien — no se le cobra al paciente ni al seguro médico

  @@map("coverage_type")
}

/// Cuánta confianza merece el dato de cobertura. La clínica a veces llama a la
/// aseguradora y a veces no; el sistema no debe fingir que siempre lo hizo.
enum CoverageVerifyMethod {
  DECLARED // Vino del intake o lo dijo el paciente — sin confirmar
  VERIFIED // Alguien llamó y la aseguradora confirmó que está activa

  @@map("coverage_verify_method")
}

model Case {
  id       String @id @default(cuid())
  caseCode String @unique // "MVA-2962" auto-generado

  // Patient (existing Patient model · puede tener varios Cases)
  patientId String
  patient   Patient @relation("PatientCases", fields: [patientId], references: [id])

  // Workflow type + Specialty
  caseType    CaseTypeWorkflow  @default(MVA)
  specialtyId String?
  specialty   SpecialtyCatalog? @relation(fields: [specialtyId], references: [id])

  // Legal: firm + attorney + paralegal + legal assistant
  lawFirmId        String?
  lawFirm          Lawyer? @relation("CaseLawFirm", fields: [lawFirmId], references: [id])
  attorneyId       String?
  attorney         Lawyer? @relation("CaseAttorney", fields: [attorneyId], references: [id])
  paralegalId      String?
  paralegal        Lawyer? @relation("CaseParalegal", fields: [paralegalId], references: [id])
  legalAssistantId String?
  legalAssistant   Lawyer? @relation("CaseLegalAssistant", fields: [legalAssistantId], references: [id])

  // Insurance — primary (PIP) + optional secondary (Med Pay)
  primaryInsuranceId    String?
  primaryInsurance      InsuranceCarrier? @relation("CasePrimaryInsurance", fields: [primaryInsuranceId], references: [id])
  primaryPolicyNumber   String?
  secondaryInsuranceId  String?
  secondaryInsurance    InsuranceCarrier? @relation("CaseSecondaryInsurance", fields: [secondaryInsuranceId], references: [id])
  secondaryPolicyNumber String?

  // ─── Cobertura: quién paga esta visita ──────────────────────────────────
  //
  // Dato OPERATIVO para el staff clínico (recepción, asistentes, doctores), no
  // para facturación. Vive en el caso y no en el paciente porque la misma
  // persona puede tener un MVA con lien y una visita de medicina general en
  // efectivo.
  //
  // Deliberadamente separado de `primaryInsuranceId`: ese campo es el carrier
  // normalizado (dato administrativo, se completa cuando alguien tiene la
  // tarjeta a mano). `coverageType` se responde en 2 clicks con el paciente
  // delante. Exigir el carrier para saber si tiene seguro es lo que dejó este
  // dato vacío hasta hoy.
  coverageType           CoverageType       @default(UNKNOWN)
  /// DECLARED = lo dijo el paciente / vino del intake · VERIFIED = alguien
  /// llamó a la aseguradora y confirmó que está activa. Null si UNKNOWN.
  coverageVerifyMethod   CoverageVerifyMethod?
  coverageVerifiedAt     DateTime?
  /// `users.id` (cuid) de quien lo respondió.
  coverageVerifiedById   String?
  /// Nombre denormalizado para que el chip muestre "verificado · Ana R." sin un
  /// join a `users` en cada fila de Mi Día (mismo criterio que
  /// `AppointmentBrace.dispensedByName` y el `correctedByName` del triaje).
  coverageVerifiedByName String?
  /// Carrier en texto libre para cuando se sabe el nombre pero todavía no se
  /// eligió el `InsuranceCarrier` normalizado. No reemplaza a la relación.
  coverageCarrierName    String?
  coverageNote           String?

  // Accident details (Phoenix prefiere acá vs Patient.accidentDate legacy)
  accidentDate     DateTime?
  accidentType     AccidentType?
  accidentLocation String?
  accidentNotes    String?       @db.Text

  // Status + flow tracking
  status CaseStatus @default(NEW_REFERRAL)

  // Intake tracking (B.3 → B.5-B.9 portal)
  intakeFormSentAt      DateTime?
  intakeFormSentVia     String? // "SMS" | "EMAIL"
  intakeFormCompletedAt DateTime?
  // Token único para el magic link del portal del paciente (B.5-B.9)
  // Phase 1A: visible en respuesta de send-portal-link para testing local
  // Phase 2: hash almacenado + Supabase Auth magic links después de BAA
  portalToken           String?   @unique

  signatureExempt Boolean   @default(false)
  pipVerifiedAt   DateTime?
  pipVerifiedById String? // userId Edson

  // Confirmation tracking (24h antes de primera cita)
  firstAppointmentConfirmedAt   DateTime?
  firstAppointmentConfirmedById String?

  // Creation context
  source          ReferralSource @default(PHONE_CALL)
  createdByUserId String? // FK opcional (Phase 1A user stub)

  // Consentimientos firmados en el wizard de creación de caso
  consentsSignedAt    DateTime?
  consentsData        Json? // { hipaa, assignedParties, assignedPartiesOpts, treatment, financial, medicalHistory }
  consentSignaturePng String?   @db.Text // base64 PNG de la firma digital

  // Twilio: duración de la llamada que originó el caso
  callDurationSeconds Int?

  // Appointments, notas y firmas del lien
  appointments         Appointment[]         @relation("CaseAppointments")
  notes                CaseNote[]
  lienSignatures       LienSignature[]
  intakeSubmission     IntakeSubmission?     @relation("CaseIntakeSubmission")
  documents            PatientDocument[]
  consents             CaseConsent[]
  authorizedDependents AuthorizedDependent[]
  callLogs             CallLog[]
  messageThreads       MessageThread[]       @relation("CaseMessageThreads")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([caseCode])
  @@index([status])
  @@index([lawFirmId])
  @@index([primaryInsuranceId])
  @@index([patientId])
  @@index([source])
  @@index([createdAt])
  @@index([coverageType])
  @@map("cases")
}

// Historial médico + preferencias capturadas en el portal B.5-B.9
// Phase 1A: almacenamiento en claro · Phase 2: encriptar PHI tras BAA Supabase
model IntakeSubmission {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation("CaseIntakeSubmission", fields: [caseId], references: [id])

  // Step 5 — Historial médico (B.7)
  healthStatus        String?
  hasMedications      Boolean @default(false)
  medications         String? @db.Text
  hasAllergies        Boolean @default(false)
  allergies           String? @db.Text
  hasPreviousInjuries Boolean @default(false)
  previousInjuries    String? @db.Text

  // Step 6 — Fotos ID
  takePhotosAtClinic Boolean @default(false)

  // Idioma elegido en el wizard
  language String @default("es")

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("intake_submissions")
}

model CaseNote {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  content   String  @db.Text
  isPrivate Boolean @default(true) // Privada (Front Office/Edson) vs compartida (Doctor también ve)

  authorUserId String? // userId del que escribió la nota
  authorName   String // Snapshot del nombre del autor (legible en historial)

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([authorUserId])
  @@map("case_notes")
}

// ─── Insurance Catalog (B.32) ─────────────────────────────────────
//
// Master data de aseguradoras donde Brunella manda HCFA y Edson verifica
// cobertura PIP. Consumido en B.2 (Recepción autocomplete), B.12 (Edson
// pre-visita), B.26 (Brunella HCFA submission).
//
// PIP (Personal Injury Protection) — coverage del seguro del paciente para
// MVA. Med Pay — coverage adicional. Health — seguro principal del paciente.

enum InsuranceType {
  PIP // Personal Injury Protection (Utah no-fault state) — primario para MVA
  MED_PAY // Medical Payments — adicional, complementario
  HEALTH // Health insurance (BCBS, UnitedHealth, etc.)
  WORKERS // Workers' compensation
  OTHER
}

enum HcfaChannel {
  EMAIL // Submit via email attachment
  FAX // Traditional fax
  PORTAL // Carrier's online portal
  PAPER // Snail mail
  EDI // Electronic Data Interchange (preferred for high-volume)
}

enum ResponseSpeed {
  FAST // < 15 días
  AVERAGE // 15-30 días
  SLOW // > 30 días (warn badge)
  UNKNOWN // sin data
}

model InsuranceCarrier {
  id String @id @default(cuid())

  name      String  @unique // "GEICO", "State Farm", "Progressive"
  legalName String? // "Government Employees Insurance"
  shortCode String // "G", "SF", "PR" (max 4 chars para avatar)
  color     String  @default("#0EA5E9") // hex para avatar bg

  type InsuranceType

  // Claims contact
  claimsPhone   String?
  claimsEmail   String?
  claimsFax     String?
  claimsAddress String? @db.Text
  portalUrl     String? // URL si tiene portal

  // HCFA submission preferences
  hcfaChannel     HcfaChannel @default(EMAIL)
  preauthRequired Boolean     @default(false)

  // Métricas (manual override Phase 1A · auto-computed Phase 2+)
  avgResponseDays Int?
  responseSpeed   ResponseSpeed @default(UNKNOWN)

  // Internal notes (Edson/Brunella privadas)
  notes String? @db.Text

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Phoenix 2026-06-06: relaciones inversas a Case
  casesAsPrimary   Case[]           @relation("CasePrimaryInsurance")
  casesAsSecondary Case[]           @relation("CaseSecondaryInsurance")
  billingPayments  BillingPayment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([isActive])
  @@index([responseSpeed])
  @@map("insurance_carriers")
}

// Junction table: many-to-many entre DoctorCredentials y SpecialtyCatalog.
// Un doctor puede pertenecer a varias especialidades (e.g. Auto Accidents + Pain Management).
// Una especialidad tiene varios doctores.
model DoctorSpecialtyAssignment {
  id                  String            @id @default(cuid())
  doctorCredentialsId String
  doctorCredentials   DoctorCredentials @relation(fields: [doctorCredentialsId], references: [id], onDelete: Cascade)
  specialtyId         String
  specialty           SpecialtyCatalog  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  // Una de las especialidades del doctor debe ser primary (la principal)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([doctorCredentialsId, specialtyId])
  @@index([specialtyId])
  @@index([doctorCredentialsId])
  @@map("doctor_specialty_assignments")
}

// ─── B.22 — Lien Signatures ──────────────────────────────────────────
//
// Firma digital del lien médico. Append-only — NUNCA se actualiza ni borra.
// Cada parte (paciente, doctor, abogado, clínica) firma por separado.
// La tabla espeja la migración 20260608050000_lien_signatures.sql.

enum LienSignerType {
  PATIENT
  GUARDIAN // Padre o apoderado firmando en representación de un paciente menor
  ATTORNEY
  DOCTOR
  CLINIC

  @@map("lien_signer_type")
}

/// Firma digital del lien médico.
/// Append-only — no UPDATE, no DELETE. Legalmente vinculante.
model LienSignature {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  signerType  LienSignerType
  signerName  String
  signerEmail String?

  signatureSvg String? @db.Text // base64 PNG o SVG path data

  signedAt DateTime @default(now())

  // Audit trail
  ipAddress    String?
  userAgent    String?
  sessionToken String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([signerType])
  @@map("lien_signatures")
}

// ─── Drug catalog ────────────────────────────────────────────────────────────

model Drug {
  id       Int     @id @default(autoincrement())
  name     String
  generic  String
  schedule String? // 'II' | 'III' | 'IV' | 'V' | null
  category String // 'NSAID' | 'RELAXANT' | 'OPIOID' | 'NEURO' | 'TOPICAL' | 'STEROID' | 'OTHER'

  @@index([category])
  @@index([generic])
  @@map("drugs")
}

model DrugInteraction {
  id            Int    @id @default(autoincrement())
  drug          String // generic name
  interactsWith String
  warning       String @db.Text

  @@index([drug])
  @@map("drug_interactions")
}

// ─── Lab / Imaging catalog ───────────────────────────────────────────────────

/// DEPRECADO — reemplazado por CatalogItem (kind = LAB). Se mantiene hasta
/// verificar la migración de los 76 estudios del v2; luego se elimina.
model LabCatalog {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  loinc    String?
  category String // 'IMAGING' | 'LABORATORY' | 'CARDIOLOGY'

  @@index([category])
  @@map("lab_catalog")
}

// ─── Catálogo de precios (labs · inyectables · servicios · férulas) ──────────
//
// Reemplaza el Excel "LabCorp Lab Pricing" que la clínica mantiene a mano.
// Los cuatro bloques comparten la misma forma — costo real + precio público —
// así que viven en una sola tabla con `kind` en vez de fragmentarse.
//
// Distinto de ServiceCode (B.33): ese es el catálogo de códigos facturables a
// aseguradora (CPT/HCPCS → HCFA). Este es la lista de precios self-pay. El
// puente entre ambos es `cptCode` / `hcpcsCode`, opcional.

enum CatalogItemKind {
  LAB // Send-out a LabCorp
  INJECTION // Inyectables aplicados en clínica
  SERVICE // In-house: EKG, rayos X, físicos, tests rápidos
  DME // Férulas, cabestrillos, botas

  @@map("catalog_item_kind")
}

/// Estado del precio. Reemplaza el texto libre que vivía en la columna NOTES
/// del Excel ("Pricing verified 8/2/2025", "Price not verified",
/// "REQUESTED PRICE UPDATE 6/29/26").
enum CatalogPriceStatus {
  VERIFIED
  UNVERIFIED
  UPDATE_REQUESTED

  @@map("catalog_price_status")
}

model CatalogItem {
  id   Int             @id @default(autoincrement())
  kind CatalogItemKind

  /// Código LabCorp para labs · PM-* interno para el resto.
  code String  @unique
  name String
  /// Solo labs: 'LABORATORY' | 'IMAGING' | 'CARDIOLOGY'.
  category String?
  /// Agrupador dentro del kind: 'CULTURES', 'PAP', 'GENERAL'.
  section String?
  loinc    String?
  /// 'LABCORP' | 'IN_HOUSE'.
  vendor String @default("IN_HOUSE")

  // ─── Precios (los tres kinds llevan costo real y precio público) ─────────
  /// Lo que nos cuesta a nosotros (columna "Lab Corp" del Excel).
  costPrice Decimal? @db.Decimal(10, 2)
  /// Lo que se le cobra al paciente (columna "Cash Price").
  publicPrice Decimal? @db.Decimal(10, 2)
  /// Precio de membresía. Null mientras no exista el programa — la UI oculta
  /// la columna si ningún ítem lo tiene cargado.
  memberPrice Decimal? @db.Decimal(10, 2)
  /// Texto cuando el precio no es un número plano (ej. "por vista").
  priceNote String?
  /// Unidad facturable variable (ej. rayos X "por vista").
  unitLabel String?

  // ─── Reflex (labs) ──────────────────────────────────────────────────────
  /// Estudios que disparan pruebas adicionales al salir positivos. En el Excel
  /// esto vivía como prosa en NOTES y nadie podía cotizarlo.
  hasReflex    Boolean  @default(false)
  reflexCost   Decimal? @db.Decimal(10, 2)
  reflexPrice  Decimal? @db.Decimal(10, 2)
  reflexPolicy String?  @db.Text // ej. "prepago, reembolsable si es negativo"

  // ─── Muestra (labs) ─────────────────────────────────────────────────────
  /// La columna "Tube Color" del Excel mezclaba tres conceptos distintos.
  tubeColors      String[] @default([]) // 'YELLOW' | 'LAVENDER' | 'LIGHT_BLUE' | ...
  containerType   String? // 'PARAPAK' | 'URINE_BOTTLE' | 'STOOL' | 'SPECIMEN'
  specialHandling String? @db.Text // 'PLASMA FROZEN', 'ROOM TEMP', 2 tubos, etc.

  // ─── DME ────────────────────────────────────────────────────────────────
  sizeLabel String? // 'any size', 'Universal Size'
  /// Férulas: se pagan completas siempre, no van a lien ni a seguro.
  alwaysFullPayment Boolean @default(false)

  // ─── Puente a facturación (opcional, se llena cuando se confirme) ───────
  cptCode   String? // ej. 96372 administración de inyectable
  hcpcsCode String? // ej. L3908 muñequera
  ndcCode   String? // ej. J1885 Toradol

  // ─── Verificación de precio ─────────────────────────────────────────────
  priceStatus     CatalogPriceStatus @default(UNVERIFIED)
  priceVerifiedAt DateTime?
  priceVerifiedBy String?

  // ─── Estado ─────────────────────────────────────────────────────────────
  isActive Boolean @default(true)
  /// Existe pero no se puede tomar/ofrecer (ej. HIV 139825 sin p24).
  isOrderable Boolean @default(true)
  /// Código que lo sustituye (ej. Histopathology 500918 → 599999).
  replacedByCode String?
  notes          String? @db.Text
  sortOrder      Int     @default(0)

  priceHistory CatalogPriceHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([kind])
  @@index([kind, category])
  @@index([priceStatus])
  @@index([isActive])
  @@map("catalog_items")
}

/// Historial de cambios de precio. Permite ver cuándo subió LabCorp el costo y
/// si el precio al paciente se ajustó en consecuencia.
model CatalogPriceHistory {
  id     Int         @id @default(autoincrement())
  itemId Int
  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  costPrice   Decimal? @db.Decimal(10, 2)
  publicPrice Decimal? @db.Decimal(10, 2)
  memberPrice Decimal? @db.Decimal(10, 2)

  changedAt     DateTime @default(now())
  changedByName String?
  reason        String?

  @@index([itemId, changedAt])
  @@map("catalog_price_history")
}

// ─── Billing Clínico (migrado de LM v2 costs + payments) ─────────────────────
// Separado del modelo Payment (que es payroll de empleados).

enum BillingPaymentSource {
  INSURANCE
  PATIENT
  LAWYER

  @@map("billing_payment_source")
}

enum BillingPaymentMethod {
  CHECK
  CARD
  CASH
  TRANSFER
  NONE

  @@map("billing_payment_method")
}

enum BillingPaymentStatus {
  COMPLETED
  CANCELLED
  PENDING

  @@map("billing_payment_status")
}

/// Ledger de facturación por cita (1:1 con Appointment).
/// Un registro por cita, generado al asignar servicios CPT.
model AppointmentBilling {
  id String @id @default(cuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  caseId String? // denormalizado para queries de billing por caso

  serviceCode        String? // CPT code, ej: "97814"
  serviceDescription String? // Descripción del servicio

  /// Cuando el cobro viene de una férula entregada (`AppointmentBrace`), se
  /// identifica por el REGISTRO y no por el código: izquierda y derecha del
  /// mismo modelo son dos cobros distintos y agrupar por código los colapsaría.
  braceId String? @unique

  /// Ídem para los servicios e inyectables del catálogo cash
  /// (`AppointmentService`): dos aplicaciones del mismo inyectable son dos
  /// cobros. `serviceCode` guarda el código del ítem solo para mostrarlo.
  cashServiceId String? @unique

  /// Ídem para los estudios de laboratorio (`LabOrder`). La clínica cobra el
  /// lab al paciente al precio público del catálogo, así que cada estudio
  /// pedido genera su fila; quitar el estudio retira el cobro.
  /// Como férulas y cash: nace con `insuranceCovered = 0` — es plata del
  /// paciente, no del seguro (los CPT son el otro circuito).
  labOrderId String? @unique

  totalCost        Decimal @default(0) @db.Decimal(10, 2)
  discount         Decimal @default(0) @db.Decimal(10, 2)
  insuranceCovered Decimal @default(0) @db.Decimal(10, 2)
  amountPaid       Decimal @default(0) @db.Decimal(10, 2)
  balanceDue       Decimal @default(0) @db.Decimal(10, 2)

  payments BillingPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([appointmentId])
  @@map("appointment_billing")
}

/// Un pago recibido contra un billing de cita.
/// Fuente: seguro PIP, copago del paciente, o pago de bufete de abogados.
model BillingPayment {
  id String @id @default(cuid())

  billingId String
  billing   AppointmentBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  source      BillingPaymentSource
  paymentType String? // "direct_insurance" | "copay" | "contractual_obligation" | etc.
  amount      Decimal              @db.Decimal(10, 2)
  method      BillingPaymentMethod @default(NONE)
  status      BillingPaymentStatus @default(COMPLETED)

  // Si source=INSURANCE, quién pagó
  insuranceCarrierId String?
  insuranceCarrier   InsuranceCarrier? @relation(fields: [insuranceCarrierId], references: [id], onDelete: SetNull)

  notes  String?   @db.Text
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingId])
  @@index([source])
  @@index([status])
  @@map("billing_payments")
}

// ─── Document Management System ──────────────────────────────────────────────
//
// Archivos y carpetas por paciente/caso. Almacenamiento en AWS S3.
// Migrado desde v2 (minioKey → s3Key). Carpetas virtuales via isFolder flag.

model PatientDocument {
  id String @id @default(cuid())

  name     String // Nombre visible del archivo o carpeta
  s3Key    String? // Ruta en S3 (nulo si isFolder=true)
  isFolder Boolean @default(false)
  size     Int? // Bytes (nulo si isFolder)
  mimeType String? // "application/pdf", "image/jpeg", etc.

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  parentId String?
  parent   PatientDocument?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children PatientDocument[] @relation("FolderChildren")

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([caseId])
  @@index([parentId])
  @@map("patient_documents")
}

// ─── Case Consents ────────────────────────────────────────────────────────────
//
// Registros individuales de consentimiento firmados por paciente/representante.
// Migrado desde v2 case_consents (15,610 registros).
// El wizard de forms app (v3) genera nuevos registros aquí.

enum ConsentCode {
  CONSENT_FOR_TREATMENT
  MEDICAL_INFORMATION_RELEASE_TO_ASSIGNED_PARTIES
  CREDIT_AND_FINANCE_CHARGE_POLICY_AND_AGREEMENT
  MEDICATION_HISTORY_AUTHORITY
  HIPAA_NOTICE_OF_PRIVACY_PRACTICES
  ASSIGNMENT_OF_BENEFITS
}

model CaseConsent {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  code     ConsentCode
  accepted Boolean     @default(false)

  // Firma — puede ser URL en Supabase Storage (v3 nuevos) o blob legacy (v2)
  signatureUrl    String? @db.Text // URL pública o presigned (v3)
  signatureLegacy String? @db.Text // base64 blob cifrado migrado de v2

  signedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([caseId, code])
  @@index([caseId])
  @@map("case_consents")
}

// ─── Twilio: Call Log ────────────────────────────────────────────────────────

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
  FAILED
  IN_PROGRESS
}

model CallLog {
  id            String  @id @default(cuid())
  twilioCallSid String? @unique

  direction       CallDirection
  fromNumber      String
  toNumber        String
  outcome         CallOutcome   @default(IN_PROGRESS)
  durationSeconds Int?

  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  agentUserId String? // userId del agente que hizo/tomó la llamada
  agentName   String? // nombre denormalizado para reportes rápidos

  recordingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([caseId])
  @@index([agentUserId])
  @@index([direction])
  @@index([outcome])
  @@index([createdAt])
  @@map("call_logs")
}

// ─── Authorized Dependents ───────────────────────────────────────────────────
//
// Personas autorizadas a actuar en nombre del paciente en un caso.
// Nombre y relación cifrados con AES-256-GCM (PHI).

model AuthorizedDependent {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  nameEncrypted         String @db.Text // AES-GCM cifrado
  relationshipEncrypted String @db.Text // AES-GCM cifrado

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("authorized_dependents")
}

// ─── Mensajería interna (M1 — módulo Clínica + portal Doctor) ────────────────
//
// Correo interno entre usuarios del back-office, calcado del flujo del EMR
// legacy (MedPrime): el mensaje casi siempre nace ANCLADO a un paciente y
// aparece tanto en los inboxes de los destinatarios como en la sección
// Mensajes del paciente. Dos capas independientes sobre el mismo hilo:
//
//  · INBOX — bandeja de trabajo de cada usuario. "Delete" es por-destinatario
//    (MessageRecipient.deletedAt), "Delete From All" es del hilo
//    (removedFromInboxesAt). Ninguno toca el historial del paciente.
//  · HISTORIAL DEL PACIENTE — permanente. Solo se borra desde ahí (soft,
//    deletedAt + AuditLog, solo admin).
//
// El SELLO (Move to Patient Folder): sealedAt congela lo previo — las entradas
// con sentAt <= sealedAt son inmutables — y saca el hilo de todos los inboxes.
// Se puede seguir agregando entradas; una entrada nueva REVIVE el hilo en los
// inboxes de todos (limpia removedFromInboxesAt y los deletedAt individuales).
//
// Todos los userId de este módulo son `users.id` (cuid de Phoenix, lo que
// devuelve resolveActor) — NO el UUID de Supabase Auth (la trampa de
// CallLog.agentUserId). Nombres denormalizados junto a cada id, mismo criterio
// que agentName / chargedByName.

enum MessageType {
  ALERT
  REMINDER
  REQUEST
  MESSAGE

  @@map("message_type")
}

enum MessageCategory {
  GENERAL
  PHONE_MESSAGE
  PATIENT_RELATED

  @@map("message_category")
}

enum MessagePriority {
  NORMAL
  URGENT

  @@map("message_priority")
}

enum MessageEntryKind {
  MESSAGE // primera entrada del hilo
  REPLY // Reply (solo al autor) / Reply All
  FORWARD // reenvío — puede sumar destinatarios nuevos
  NOTE // Add Note: anotación sobre el hilo, notifica a todos
  SEAL_NOTE // nota final capturada al sellar (Move to Patient Folder with Note)

  @@map("message_entry_kind")
}

enum MessageRecipientKind {
  TO
  CC

  /// El AUTOR del hilo. Es participante para que el mensaje que mandó le
  /// aparezca en su propia bandeja —como en el EMR legacy, donde la lista son
  /// "los hilos en los que participo", no solo los recibidos— pero con tipo
  /// propio para que la cabecera del mensaje siga mostrando en "To:" solo a
  /// quienes se les escribió. Se crea con `lastReadAt` puesto: nadie estrena su
  /// propio mensaje en negrita.
  SENDER

  @@map("message_recipient_kind")
}

model MessageThread {
  id String @id @default(cuid())

  subject  String
  type     MessageType     @default(MESSAGE)
  category MessageCategory @default(GENERAL)
  priority MessagePriority @default(NORMAL)

  // Vínculo opcional — el 99% de los hilos lo llevan; los creados desde el
  // inbox sin paciente viven solo en las bandejas de los participantes.
  patientId String?
  patient   Patient? @relation("PatientMessageThreads", fields: [patientId], references: [id])
  caseId    String?
  case      Case?    @relation("CaseMessageThreads", fields: [caseId], references: [id])

  createdByUserId String
  createdByName   String

  // Sello — Move to Patient Folder (±nota). Congela lo previo y saca el hilo
  // de todos los inboxes. NO impide agregar entradas nuevas.
  sealedAt       DateTime?
  sealedByUserId String?
  sealedByName   String?

  // Delete From All — fuera de todos los inboxes, intacto en el paciente.
  removedFromInboxesAt DateTime?

  // Borrado desde el historial del paciente — la única eliminación real.
  // Soft a propósito: es registro clínico-operativo (criterio férulas/labs).
  deletedAt       DateTime?
  deletedByUserId String?

  /// Denormalizado: sentAt de la última entrada. Ordena los inboxes y decide
  /// el bold (lastEntryAt > MessageRecipient.lastReadAt) sin agregar sobre
  /// message_entries en cada listado.
  lastEntryAt DateTime @default(now())

  entries    MessageEntry[]
  recipients MessageRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([caseId])
  @@index([lastEntryAt])
  @@index([deletedAt])
  @@map("message_threads")
}

model MessageEntry {
  id       String        @id @default(cuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  kind MessageEntryKind @default(MESSAGE)

  authorUserId String
  authorName   String // snapshot — el hilo muestra quién escribió sin join

  /// HTML del RichTextEditor (mismo formato que las plantillas clínicas).
  body String @db.Text

  sentAt DateTime @default(now())

  /// Corregido por su autor DESPUÉS de enviarlo. Solo se permite mientras
  /// ningún otro participante lo haya leído (`lastReadAt` < `sentAt`): editar
  /// algo que alguien ya leyó y pudo haber ejecutado no es corregir un typo, es
  /// reescribir un registro clínico a espaldas de quien actuó sobre él. Para eso
  /// está responder con la corrección, que deja los dos hechos en orden.
  /// La marca es visible en el hilo; el texto anterior queda en el AuditLog.
  editedAt DateTime?

  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, sentAt])
  @@index([authorUserId])
  @@map("message_entries")
}

model MessageRecipient {
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// users.id (cuid Phoenix) — ver nota de cabecera del módulo.
  userId   String
  userName String // snapshot para pintar To/CC sin join

  kind MessageRecipientKind @default(TO)

  /// Read-state POR HILO (estilo Gmail): bold si thread.lastEntryAt > lastReadAt.
  /// Cualquier entrada nueva —reply, nota, incluso post-sello— re-embolda para
  /// todos sin tocar filas. Solo lo escribe el DUEÑO del inbox: mirar el inbox
  /// de otro usuario nunca marca leído.
  lastReadAt DateTime?

  /// Mi "Delete" personal: fuera de MI inbox, nadie más se entera.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@id([threadId, userId])
  @@index([userId, deletedAt])
  @@map("message_recipients")
}

/// Plantilla de mensaje (M1 F4) — el panel de plantillas del legacy
/// (DM/Prediabetes instructions, Lab results…). Compartidas por toda la
/// clínica: cualquiera las usa, cualquiera puede crear; borrado soft.
model MessageTemplate {
  id    String @id @default(cuid())
  title String
  /// HTML del RichTextEditor, mismo formato que MessageEntry.body
  body  String @db.Text

  createdByUserId String
  createdByName   String

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("message_templates")
}

/// Borrador de mensaje (M1 F4 — Save as Draft). Privado del autor: el
/// formulario completo del compose serializado en `payload` (to/cc/tipo/
/// categoría/prioridad/asunto/cuerpo/adjuntos/paciente). Se elimina al enviar.
model MessageDraft {
  id     String @id @default(cuid())
  userId String

  /// Denormalizados para listar borradores sin deserializar el payload
  subject     String?
  patientId   String?
  patientName String?

  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("message_drafts")
}

model MessageAttachment {
  id      String       @id @default(cuid())
  entryId String
  entry   MessageEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// "Attach From Chart" — referencia a un documento existente del paciente.
  /// Sin FK: el documento puede borrarse y el mensaje debe seguir contando
  /// que se adjuntó (queda fileName como evidencia).
  patientDocumentId String?

  /// Subida nueva → bucket privado `message-attachments` (criterio lab-results).
  fileUrl String?

  fileName     String
  documentType String?
  description  String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@map("message_attachments")
}

# Dependencies
node_modules/

# Next.js
.next/
# Directorios de build alternativos: `NEXT_DIST_DIR=.next-algo npx next build`
# (ver `distDir` en apps/back-office/next.config.mjs). El patrón va con comodín a
# propósito: cada sesión elige su nombre —`.next-verify`, `.next-agente`— y una
# regla por nombre deja el siguiente sin cubrir. Ya pasó: `.next-agente/`
# apareció como "sin trackear" y un `git add -A` habría subido un build entero.
.next-*/
out/

# Turbo
.turbo/

# Build
dist/

# Environment
.env
.env.local
.env.*.local
# Copias de seguridad de .env — traen SERVICE_ROLE_KEY y DATABASE_URL en claro
.env*.bak*
*.env.bak*

# Artefactos del build de la PWA (next-pwa los regenera en cada build)
apps/*/public/sw.js
apps/*/public/sw.js.map
apps/*/public/workbox-*.js
apps/*/public/workbox-*.js.map
# `worker-<hash>.js` — el hash cambia en cada build, así que commitearlo mete un
# archivo que caduca solo y ensucia el diff de la siguiente sesión que buildee.
# OJO: esto NO alcanza a `apps/back-office/worker/` (sin `public/`), que es
# FUENTE de la PWA y sí va al repo.
apps/*/public/worker-*.js
apps/*/public/worker-*.js.map

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Supabase
supabase/.temp/

# PWA generated files
# apps/web uses Serwist, which DOES regenerate the SW on every Vercel
# build correctly — those artifacts stay ignored.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map
apps/web/public/worker-*.js
apps/web/public/worker-*.js.map
apps/web/public/swe-worker-*.js
apps/web/public/swe-worker-*.js.map

# apps/timeclock uses @ducanh2912/next-pwa which silently fails to
# generate the SW during Vercel build (monorepo + Next 15 issue, while
# the local build works fine). We track the SW + workbox runtime
# manually so production has them. Regenerate locally with:
#   pnpm build --filter=@precision-medical/timeclock
# then commit any changes to apps/timeclock/public/{sw,workbox-*,swe-worker-*}.js
# Follow-up: migrate timeclock to @serwist/next (same as apps/web).
.vercel
.env*
!.env.example

# Config local de Claude Code — rutas y permisos de esta maquina, no del repo
.claude/settings.local.json

# ─── PHI: los export del v2 NUNCA van al repo ────────────────────────────────
# `Migracion/` son los CSV crudos de MedUSA: 6.182 pacientes con nombre, SSN,
# teléfono y firmas. Estaba SIN ignorar y sin trackear, o sea a un `git add -A`
# de quedar publicado — y en este repo ya pasó una vez (el commit 605154f7 subió
# secretos y estuvieron 7 semanas en GitHub; un revert no los saca del historial).
# Lo mismo para cualquier respaldo de la base.
Migracion/
respaldo-*/
*.ndjson

# Salidas de los scripts de migración: llevan datos de pacientes o del staff.
# `inventario.json` guarda 2 valores de MUESTRA por columna — o sea correos y
# nombres reales—; los id-maps son la tabla de equivalencias v2↔v3.
scripts/migration/id-maps/
scripts/migration/inventario.json
scripts/migration/mapa-doctores.json
scripts/migration/pacientes-a-fusionar.json
scripts/migration/companies-duplicados.json
scripts/migration/bufetes-fuera-del-catalogo.json
scripts/migration/documentos-progreso.json
scripts/migration/documentos-fallidos.json
